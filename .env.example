# ReguLens Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=ReguLens
APP_VERSION=0.1.0
DEBUG=true

# Database (local PostgreSQL for MVP)
# Must be valid PostgreSQL connection string: postgresql://user:pass@host:port/dbname
DATABASE_URL=postgresql://regulens_user:regulens_pass@localhost:5432/regulens

# Alert Configuration (MVP - single recipient)
# Email must be valid format (e.g., user@domain.com)
ALERT_RECIPIENT_EMAIL=your-email@example.com
ALERT_RECIPIENT_NAME=Tax Professional (MVP)

# API Keys
# Anthropic keys must start with 'sk-ant-' and be at least 50 characters
ANTHROPIC_API_KEY=sk-ant-...
# Resend keys must start with 're_'
RESEND_API_KEY=re_...

# Scraping Configuration
# Hour must be 0-23 (hour of day to run scraping)
SCRAPE_SCHEDULE_HOUR=8
# Timeout must be positive integer, max 300 seconds (5 minutes)
SCRAPE_TIMEOUT_SECONDS=30
